[
  {
    "start": "00:00:00.000",
    "end": "00:00:04.000",
    "text": "Một tháng, ăn thịt gà"
  },
  {
    "start": "00:00:11.000",
    "end": "00:00:15.000",
    "text": "Mới chậm mắc có tý mà mặc tờ đã đến đánh đậm đầu rồi"
  },
  {
    "start": "00:00:15.000",
    "end": "00:00:19.000",
    "text": "Thôi quá, phải đi kiếm viên gì bỏ buồn thôi"
  },
  {
    "start": "00:00:20.000",
    "end": "00:00:21.000",
    "text": "Ăn kia đi kiếm viên làm thuyền hả?"
  },
  {
    "start": "00:00:21.000",
    "end": "00:00:23.000",
    "text": "Rùn lúa nhà ta đang thiêu người gắn"
  },
  {
    "start": "00:00:23.000",
    "end": "00:00:25.000",
    "text": "Có muốn nhận viên không?"
  },
  {
    "start": "00:00:25.000",
    "end": "00:00:27.000",
    "text": "Ta đã cho nằm động công"
  },
  {
    "start": "00:00:27.000",
    "end": "00:00:29.000",
    "text": "Ngoi trời, tôi đang đối lã ra đây"
  },
  {
    "start": "00:00:29.000",
    "end": "00:00:34.000",
    "text": "Ta chân bụng rũng, giờ mà đi làm thuy cho nhà ông, có mận ngất lã ra đây"
  },
  {
    "start": "00:00:35.000",
    "end": "00:00:39.000",
    "text": "Không làm thịt lây đâu ra cây mà ăn"
  },
  {
    "start": "00:00:40.000",
    "end": "00:00:42.000",
    "text": "Làm gì thì làm?"
  },
  {
    "start": "00:00:42.000",
    "end": "00:00:43.000",
    "text": "Cái gì?"
  },
  {
    "start": "00:00:43.000",
    "end": "00:00:44.000",
    "text": "Cái gì?"
  },
  {
    "start": "00:00:44.000",
    "end": "00:00:45.000",
    "text": "Cái gì?"
  },
  {
    "start": "00:00:45.000",
    "end": "00:00:46.000",
    "text": "Cái gì?"
  },
  {
    "start": "00:00:47.000",
    "end": "00:00:49.000",
    "text": "Làm gì thì làm?"
  },
  {
    "start": "00:00:49.000",
    "end": "00:00:52.000",
    "text": "Thứ bảo mình đi gặp lúa thuê cho lãu phụ ông hết dịch kia có mà"
  },
  {
    "start": "00:00:52.000",
    "end": "00:00:54.000",
    "text": "Thà mình chịu đối còn hơn"
  },
  {
    "start": "00:00:54.000",
    "end": "00:00:57.000",
    "text": "Ê lưng ra lãng thuê cho lãu, trả được nằm động"
  },
  {
    "start": "00:01:01.000",
    "end": "00:01:03.000",
    "text": "Chào anh hai, chị hai"
  },
  {
    "start": "00:01:03.000",
    "end": "00:01:05.000",
    "text": "Chú nằm đoè, chú đi đầu thế"
  },
  {
    "start": "00:01:05.000",
    "end": "00:01:06.000",
    "text": "Nhà em tung quá"
  },
  {
    "start": "00:01:06.000",
    "end": "00:01:09.000",
    "text": "Từ qua đất giờ không có gì bỏ vào buồn"
  },
  {
    "start": "00:01:09.000",
    "end": "00:01:11.000",
    "text": "Em đối sắp ngất rồi"
  },
  {
    "start": "00:01:11.000",
    "end": "00:01:14.000",
    "text": "Chào có thần tôi lại cố thì này cơ chứ"
  },
  {
    "start": "00:01:14.000",
    "end": "00:01:16.000",
    "text": "Trời ơi lại trời"
  },
  {
    "start": "00:01:16.000",
    "end": "00:01:18.000",
    "text": "Thê chú dậu này làm gì rồi"
  },
  {
    "start": "00:01:18.000",
    "end": "00:01:20.000",
    "text": "Vậy khó thì em làm không được"
  },
  {
    "start": "00:01:20.000",
    "end": "00:01:22.000",
    "text": "Còn mấy việc nặng nhọc quá"
  },
  {
    "start": "00:01:22.000",
    "end": "00:01:24.000",
    "text": "Thì em làm gì có sức mà làm"
  },
  {
    "start": "00:01:24.000",
    "end": "00:01:26.000",
    "text": "Cái số của em đúng là hậm cứ hiêu"
  },
  {
    "start": "00:01:26.000",
    "end": "00:01:29.000",
    "text": "Cái gì đen, đủy, đổ hết lên đầu em"
  },
  {
    "start": "00:01:29.000",
    "end": "00:01:31.000",
    "text": "Em chán lắm đồ ăn chỉ rả"
  },
  {
    "start": "00:01:31.000",
    "end": "00:01:32.000",
    "text": "Bàu đây"
  },
  {
    "start": "00:01:32.000",
    "end": "00:01:34.000",
    "text": "Tuyện thể nhà ăn cũng chuẩn bị ăn chưa"
  },
  {
    "start": "00:01:34.000",
    "end": "00:01:35.000",
    "text": "Vào đây ngồi với anh"
  },
  {
    "start": "00:01:35.000",
    "end": "00:01:37.000",
    "text": "Mình xuống nhà giống mâm lên nhé"
  },
  {
    "start": "00:01:42.000",
    "end": "00:01:46.000",
    "text": "Chú nằm mà chú cũng là kiếm đường mà làm ăn đi"
  },
  {
    "start": "00:01:46.000",
    "end": "00:01:48.000",
    "text": "Cô lòng bông mãi như thế này không được"
  },
  {
    "start": "00:01:48.000",
    "end": "00:01:50.000",
    "text": "Cũng phải lo làm lụng"
  },
  {
    "start": "00:01:50.000",
    "end": "00:01:52.000",
    "text": "Giành dụng mà lấy vỡ nữa chưa"
  },
  {
    "start": "00:01:52.000",
    "end": "00:01:54.000",
    "text": "Em cũng muốn thay lắm chưa"
  },
  {
    "start": "00:01:54.000",
    "end": "00:01:55.000",
    "text": "Nhưng anh xem"
  },
  {
    "start": "00:01:55.000",
    "end": "00:01:57.000",
    "text": "Cái số em nó thay"
  },
  {
    "start": "00:01:57.000",
    "end": "00:01:59.000",
    "text": "Bốn làm ăn tự tới, cũng không có vốn"
  },
  {
    "start": "00:01:59.000",
    "end": "00:02:01.000",
    "text": "Chứ em mà có vốn trong tay"
  },
  {
    "start": "00:02:01.000",
    "end": "00:02:02.000",
    "text": "Thì chắc chắn"
  },
  {
    "start": "00:02:02.000",
    "end": "00:02:04.000",
    "text": "Em sẽ dào lên nhân chống thôi"
  },
  {
    "start": "00:02:05.000",
    "end": "00:02:07.000",
    "text": "À hay là"
  },
  {
    "start": "00:02:07.000",
    "end": "00:02:09.000",
    "text": "Anh chỉ có điều kiện thì giúp em"
  },
  {
    "start": "00:02:09.000",
    "end": "00:02:11.000",
    "text": "Cho em vầy một số tiền vốn làm ăn"
  },
  {
    "start": "00:02:11.000",
    "end": "00:02:12.000",
    "text": "Sau này khấm khá"
  },
  {
    "start": "00:02:12.000",
    "end": "00:02:14.000",
    "text": "Em sẽ trả cả vốn lần lời"
  },
  {
    "start": "00:02:16.000",
    "end": "00:02:19.000",
    "text": "Tuyền bà cá thì anh chỉ cũng không có như giả gì"
  },
  {
    "start": "00:02:19.000",
    "end": "00:02:20.000",
    "text": "Nhưng mà được rồi"
  },
  {
    "start": "00:02:20.000",
    "end": "00:02:23.000",
    "text": "Anh chỉ sẽ cho chú vầy một con châu và một nằm gà"
  },
  {
    "start": "00:02:23.000",
    "end": "00:02:25.000",
    "text": "Với châu và gà"
  },
  {
    "start": "00:02:25.000",
    "end": "00:02:26.000",
    "text": "Nếu chú biết chăm chỉ làm ăn"
  },
  {
    "start": "00:02:26.000",
    "end": "00:02:28.000",
    "text": "Thì số sẽ khấm khá lên thôi"
  },
  {
    "start": "00:02:28.000",
    "end": "00:02:30.000",
    "text": "Chả mấy mà thành công"
  },
  {
    "start": "00:02:30.000",
    "end": "00:02:31.000",
    "text": "Ê"
  },
  {
    "start": "00:02:31.000",
    "end": "00:02:32.000",
    "text": "Đổi ở ngăn chỉ"
  },
  {
    "start": "00:02:32.000",
    "end": "00:02:34.000",
    "text": "Nhất định em sẽ làm ăn tự tới"
  },
  {
    "start": "00:02:34.000",
    "end": "00:02:36.000",
    "text": "Trả đợi anh chỉ cả vốn lần lời"
  },
  {
    "start": "00:02:37.000",
    "end": "00:02:41.000",
    "text": "Tất cả là thật không phải mơ"
  },
  {
    "start": "00:02:41.000",
    "end": "00:02:42.000",
    "text": "Chứ không mình thấy mà hơn"
  },
  {
    "start": "00:02:42.000",
    "end": "00:02:45.000",
    "text": "Từ nay thì gọi phải đi chăng câu cho lạo của ông rồi"
  },
  {
    "start": "00:02:46.000",
    "end": "00:02:48.000",
    "text": "Nhưng vượt mấy hiếp có này"
  },
  {
    "start": "00:02:48.000",
    "end": "00:02:51.000",
    "text": "Mình phải thành công gà béo này để ăn mừng mưa"
  },
  {
    "start": "00:03:00.000",
    "end": "00:03:01.000",
    "text": "Khi lũ gà này"
  },
  {
    "start": "00:03:01.000",
    "end": "00:03:02.000",
    "text": "Này một đầy"
  },
  {
    "start": "00:03:02.000",
    "end": "00:03:03.000",
    "text": "Càng nuôi càng gây"
  },
  {
    "start": "00:03:03.000",
    "end": "00:03:04.000",
    "text": "Lấy mất giá mất"
  },
  {
    "start": "00:03:04.000",
    "end": "00:03:06.000",
    "text": "Mà gà đôi cũng để ăn"
  },
  {
    "start": "00:03:06.000",
    "end": "00:03:07.000",
    "text": "Đang đôi"
  },
  {
    "start": "00:03:07.000",
    "end": "00:03:08.000",
    "text": "Đang lúc cho nhanh"
  },
  {
    "start": "00:03:17.000",
    "end": "00:03:19.000",
    "text": "Kha kha"
  },
  {
    "start": "00:03:19.000",
    "end": "00:03:21.000",
    "text": "Vậy thì còn ai sướng bằng ta"
  },
  {
    "start": "00:03:21.000",
    "end": "00:03:23.000",
    "text": "Gày nào cũng có gà để ăn"
  },
  {
    "start": "00:03:24.000",
    "end": "00:03:25.000",
    "text": "Thế rồi"
  },
  {
    "start": "00:03:25.000",
    "end": "00:03:27.000",
    "text": "Mấy ngày nay quên không cho con châu ăn"
  },
  {
    "start": "00:03:27.000",
    "end": "00:03:28.000",
    "text": "Không biết có sao không nữa"
  },
  {
    "start": "00:03:30.000",
    "end": "00:03:31.000",
    "text": "Cái gì thế này"
  },
  {
    "start": "00:03:31.000",
    "end": "00:03:33.000",
    "text": "Bới có một tuần không ăn"
  },
  {
    "start": "00:03:34.000",
    "end": "00:03:35.000",
    "text": "Chắc phải bán châu thôi"
  },
  {
    "start": "00:03:35.000",
    "end": "00:03:37.000",
    "text": "Xem vước phát được đồng nào"
  },
  {
    "start": "00:03:41.000",
    "end": "00:03:42.000",
    "text": "Ê đôi quá"
  },
  {
    "start": "00:03:42.000",
    "end": "00:03:44.000",
    "text": "Nhà hết cái ăn rồi"
  },
  {
    "start": "00:03:44.000",
    "end": "00:03:46.000",
    "text": "Giờ châu cũng không còn"
  },
  {
    "start": "00:03:46.000",
    "end": "00:03:47.000",
    "text": "Gà cũng hết"
  },
  {
    "start": "00:03:47.000",
    "end": "00:03:49.000",
    "text": "Tuyền bán châu ăn được mấy bữa chả bỏ"
  },
  {
    "start": "00:03:50.000",
    "end": "00:03:52.000",
    "text": "Đôi chả có gì bỏ vụng làm sao"
  },
  {
    "start": "00:03:52.000",
    "end": "00:03:53.000",
    "text": "Đây"
  },
  {
    "start": "00:03:53.000",
    "end": "00:03:55.000",
    "text": "Chắc muối mặt sang nhận hai giúp nữa thôi"
  },
  {
    "start": "00:03:58.000",
    "end": "00:03:59.000",
    "text": "Thế là sao"
  },
  {
    "start": "00:03:59.000",
    "end": "00:04:01.000",
    "text": "Châu gà đấu hết rồi chú nằm"
  },
  {
    "start": "00:04:01.000",
    "end": "00:04:03.000",
    "text": "Mấy hầm đôi quá"
  },
  {
    "start": "00:04:03.000",
    "end": "00:04:05.000",
    "text": "Em làm thịt mấy con gà ăn tạm"
  },
  {
    "start": "00:04:05.000",
    "end": "00:04:06.000",
    "text": "Đôi"
  },
  {
    "start": "00:04:06.000",
    "end": "00:04:08.000",
    "text": "Thì"
  },
  {
    "start": "00:04:08.000",
    "end": "00:04:09.000",
    "text": "Mấy con mấy hầm"
  },
  {
    "start": "00:04:09.000",
    "end": "00:04:11.000",
    "text": "Quật đôi châu ăn mà nó đã"
  },
  {
    "start": "00:04:11.000",
    "end": "00:04:13.000",
    "text": "Giờ em đôi quá"
  },
  {
    "start": "00:04:13.000",
    "end": "00:04:15.000",
    "text": "Đến nước này"
  },
  {
    "start": "00:04:15.000",
    "end": "00:04:17.000",
    "text": "Chú không thể đổ lỗi cho sống phận được rồi"
  },
  {
    "start": "00:04:17.000",
    "end": "00:04:19.000",
    "text": "Chú đã có một con châu"
  },
  {
    "start": "00:04:19.000",
    "end": "00:04:20.000",
    "text": "Một đàn gà"
  },
  {
    "start": "00:04:20.000",
    "end": "00:04:21.000",
    "text": "Nếu chăm chỉ ra"
  },
  {
    "start": "00:04:21.000",
    "end": "00:04:23.000",
    "text": "Tới giờ đã sắp có trứng gà bán rồi"
  },
  {
    "start": "00:04:23.000",
    "end": "00:04:25.000",
    "text": "Rượt nữa có cả nghe con"
  },
  {
    "start": "00:04:25.000",
    "end": "00:04:27.000",
    "text": "Tôi đã giúp chú cái cần cầu"
  },
  {
    "start": "00:04:27.000",
    "end": "00:04:28.000",
    "text": "Vậy mà chú vẫn ý lại"
  },
  {
    "start": "00:04:28.000",
    "end": "00:04:29.000",
    "text": "Lời miếng hết thương chứ"
  },
  {
    "start": "00:04:29.000",
    "end": "00:04:31.000",
    "text": "Dân lỗi chú"
  },
  {
    "start": "00:04:31.000",
    "end": "00:04:33.000",
    "text": "Chúc tồi có giấm chú thì nào"
  },
  {
    "start": "00:04:33.000",
    "end": "00:04:34.000",
    "text": "Cũng vô nghĩ mà thôi"
  },
  {
    "start": "00:04:34.000",
    "end": "00:04:35.000",
    "text": "Chú về đi"
  },
  {
    "start": "00:04:35.000",
    "end": "00:04:36.000",
    "text": "Anh"
  },
  {
    "start": "00:04:36.000",
    "end": "00:04:37.000",
    "text": "Anh ơi"
  },
  {
    "start": "00:04:37.000",
    "end": "00:04:38.000",
    "text": "Ờ"
  },
  {
    "start": "00:04:38.000",
    "end": "00:04:39.000",
    "text": "Xong lại thế chứ"
  }
]