[
  {
    "start": "00:00:00.000",
    "end": "00:00:05.000",
    "text": "Chỉ cần có mẹ thôi."
  },
  {
    "start": "00:00:11.000",
    "end": "00:00:14.000",
    "text": "Đời, mẹ về rồi này."
  },
  {
    "start": "00:00:14.000",
    "end": "00:00:19.000",
    "text": "Mẹ ơi, con hoặc cho mẹ chết, mất không mẹ."
  },
  {
    "start": "00:00:19.000",
    "end": "00:00:23.000",
    "text": "Bắc, bắc lắm, còn cái yếu của mẹ giỏi quá."
  },
  {
    "start": "00:00:23.000",
    "end": "00:00:25.000",
    "text": "Đúng là mau mũ."
  },
  {
    "start": "00:00:25.000",
    "end": "00:00:28.000",
    "text": "Sau 7 tuổi đậu đã biết thương mẹ rồi."
  },
  {
    "start": "00:00:28.000",
    "end": "00:00:31.000",
    "text": "Chứ không như cái người bạc tình bạc nghĩa kia."
  },
  {
    "start": "00:00:31.000",
    "end": "00:00:34.000",
    "text": "Mẹ, trở đánh đánh mấy ngang."
  },
  {
    "start": "00:00:34.000",
    "end": "00:00:37.000",
    "text": "Sao mẹ cứ lôi cái chuyện thấy đã nói giữa bữa cơm mới được à?"
  },
  {
    "start": "00:00:39.000",
    "end": "00:00:44.000",
    "text": "Tái bà mà mẹ dẫn rồi, con không cho với bà nữa."
  },
  {
    "start": "00:00:50.000",
    "end": "00:00:52.000",
    "text": "Chưa ngũ còn làm cái gì đó?"
  },
  {
    "start": "00:00:53.000",
    "end": "00:00:55.000",
    "text": "Còn dẫn mẹ."
  },
  {
    "start": "00:00:55.000",
    "end": "00:00:57.000",
    "text": "Mẹ, sao mẹ lại nói thế?"
  },
  {
    "start": "00:00:57.000",
    "end": "00:01:02.000",
    "text": "Dù gì cũng tại con mà con bé không có được hành phúc đồn vẹn từ cá bà và mẹ."
  },
  {
    "start": "00:01:02.000",
    "end": "00:01:04.000",
    "text": "Còn thấy mình tự quá."
  },
  {
    "start": "00:01:04.000",
    "end": "00:01:08.000",
    "text": "Mẹ, con định sẽ lên thành phố lập nghiệp."
  },
  {
    "start": "00:01:08.000",
    "end": "00:01:11.000",
    "text": "Còn đậu diễn nổi tiếng về nhà mái tập vân nghị."
  },
  {
    "start": "00:01:11.000",
    "end": "00:01:13.000",
    "text": "Ông kèn con hát hay, lại ươi nhìn."
  },
  {
    "start": "00:01:13.000",
    "end": "00:01:16.000",
    "text": "Ông sẽ giúp con trở thành diễn viên."
  },
  {
    "start": "00:01:16.000",
    "end": "00:01:19.000",
    "text": "Tưởng lên được TV mà dễ."
  },
  {
    "start": "00:01:19.000",
    "end": "00:01:21.000",
    "text": "Bảo khóc vài khóc."
  },
  {
    "start": "00:01:21.000",
    "end": "00:01:24.000",
    "text": "Bảo cười phải cười. Còn làm được không."
  },
  {
    "start": "00:01:24.000",
    "end": "00:01:26.000",
    "text": "Còn cũng có tốt chức mà mẹ."
  },
  {
    "start": "00:01:26.000",
    "end": "00:01:28.000",
    "text": "Dĩnh thì tập là được mà."
  },
  {
    "start": "00:01:28.000",
    "end": "00:01:30.000",
    "text": "Còn con đà để cho ai."
  },
  {
    "start": "00:01:30.000",
    "end": "00:01:32.000",
    "text": "Ở nhà với bà chứ sao?"
  },
  {
    "start": "00:01:32.000",
    "end": "00:01:35.000",
    "text": "Người ta cho mình cơ hội mà không nắm lấy là thiệt."
  },
  {
    "start": "00:01:36.000",
    "end": "00:01:38.000",
    "text": "Còn nghĩ cho kỳ đi."
  },
  {
    "start": "00:01:38.000",
    "end": "00:01:40.000",
    "text": "Nó còn nhỏ."
  },
  {
    "start": "00:01:40.000",
    "end": "00:01:42.000",
    "text": "Bà đã không có rồi."
  },
  {
    "start": "00:01:42.000",
    "end": "00:01:45.000",
    "text": "Mẹ đi nữa, không được đâu con."
  },
  {
    "start": "00:01:45.000",
    "end": "00:01:48.000",
    "text": "Mẹ cứ làm như con đi hẳn không về nữa ấy."
  },
  {
    "start": "00:01:48.000",
    "end": "00:01:50.000",
    "text": "Bàu giờ con đi."
  },
  {
    "start": "00:01:50.000",
    "end": "00:01:52.000",
    "text": "Cuối tuần con đi rồi mẹ á."
  },
  {
    "start": "00:01:52.000",
    "end": "00:01:53.000",
    "text": "Mẹ ơi."
  },
  {
    "start": "00:01:53.000",
    "end": "00:01:55.000",
    "text": "Mẹ thương con thương cháo."
  },
  {
    "start": "00:01:55.000",
    "end": "00:01:57.000",
    "text": "Mẹ cô gắn chờ con đổi đời mẹ nha."
  },
  {
    "start": "00:02:01.000",
    "end": "00:02:03.000",
    "text": "Chỉ xem kĩ lại giúp em với."
  },
  {
    "start": "00:02:03.000",
    "end": "00:02:07.000",
    "text": "Đạo diễn kìa nói sẽ giúp em đang kí vào lớp diễn viên tài năng mà."
  },
  {
    "start": "00:02:07.000",
    "end": "00:02:08.000",
    "text": "Tôi không biết."
  },
  {
    "start": "00:02:08.000",
    "end": "00:02:11.000",
    "text": "Tôi chỉ tuyển người đóng thú bông trong công viên thôi."
  },
  {
    "start": "00:02:11.000",
    "end": "00:02:12.000",
    "text": "Cô có làm không?"
  },
  {
    "start": "00:02:12.000",
    "end": "00:02:14.000",
    "text": "đóng thú bông ngư."
  },
  {
    "start": "00:02:15.000",
    "end": "00:02:19.000",
    "text": "Trở ràng anh ấy cầm của tôi 10 triệu tiền phí đào tạo rồi mà."
  },
  {
    "start": "00:02:19.000",
    "end": "00:02:21.000",
    "text": "Cô này hay gì?"
  },
  {
    "start": "00:02:21.000",
    "end": "00:02:22.000",
    "text": "Nói bao nhiêu lần rồi."
  },
  {
    "start": "00:02:22.000",
    "end": "00:02:25.000",
    "text": "Một là làm hay là về đi cho tôi làm việc."
  },
  {
    "start": "00:02:25.000",
    "end": "00:02:27.000",
    "text": "Sáng đã đã lặng nhận."
  },
  {
    "start": "00:02:32.000",
    "end": "00:02:35.000",
    "text": "Này làm sao bây giờ hả cô?"
  },
  {
    "start": "00:02:35.000",
    "end": "00:02:37.000",
    "text": "Mẹ làm mất hết rồi."
  },
  {
    "start": "00:02:37.000",
    "end": "00:02:41.000",
    "text": "Mẹ còn mất mỗi nào nhìn bà nhìn con đữ thế."
  },
  {
    "start": "00:02:42.000",
    "end": "00:02:44.000",
    "text": "Cô việc đâm giảm lắm."
  },
  {
    "start": "00:02:44.000",
    "end": "00:02:46.000",
    "text": "Quảng trò báo làm gì thì làm."
  },
  {
    "start": "00:02:46.000",
    "end": "00:02:48.000",
    "text": "Thần thiện với tụi trẻ con là nước."
  },
  {
    "start": "00:02:48.000",
    "end": "00:02:50.000",
    "text": "Nghĩ mua hoặc náo vào đấy."
  },
  {
    "start": "00:02:50.000",
    "end": "00:02:51.000",
    "text": "Vâng hả?"
  },
  {
    "start": "00:02:58.000",
    "end": "00:02:59.000",
    "text": "Còn đáy hả?"
  },
  {
    "start": "00:02:59.000",
    "end": "00:03:01.000",
    "text": "Mẹ nữ con quá."
  },
  {
    "start": "00:03:01.000",
    "end": "00:03:03.000",
    "text": "Một vẻ với con quá."
  },
  {
    "start": "00:03:03.000",
    "end": "00:03:06.000",
    "text": "Yết gì mọi việc chỉ như mụng chức mơ thôi."
  },
  {
    "start": "00:03:08.000",
    "end": "00:03:09.000",
    "text": "Có đoạn học sinh đến đây."
  },
  {
    "start": "00:03:09.000",
    "end": "00:03:10.000",
    "text": "Chính giật tốt vào nhé."
  },
  {
    "start": "00:03:11.000",
    "end": "00:03:12.000",
    "text": "Giặt con."
  },
  {
    "start": "00:03:12.000",
    "end": "00:03:14.000",
    "text": "Chúng mình đứng chào bắt gấu đi nào."
  },
  {
    "start": "00:03:16.000",
    "end": "00:03:17.000",
    "text": "Thôi được."
  },
  {
    "start": "00:03:17.000",
    "end": "00:03:18.000",
    "text": "Bên à."
  },
  {
    "start": "00:03:18.000",
    "end": "00:03:20.000",
    "text": "Là bên à phải không nhỉ?"
  },
  {
    "start": "00:03:20.000",
    "end": "00:03:22.000",
    "text": "Không phải để con bé nhận ra mình được."
  },
  {
    "start": "00:03:23.000",
    "end": "00:03:24.000",
    "text": "Chê ha."
  },
  {
    "start": "00:03:24.000",
    "end": "00:03:26.000",
    "text": "Vụng bắt gấu em quá."
  },
  {
    "start": "00:03:26.000",
    "end": "00:03:27.000",
    "text": "Còn em nữa."
  },
  {
    "start": "00:03:27.000",
    "end": "00:03:29.000",
    "text": "Em như bụng mẹ ấy."
  },
  {
    "start": "00:03:31.000",
    "end": "00:03:32.000",
    "text": "Bắt gấu."
  },
  {
    "start": "00:03:32.000",
    "end": "00:03:33.000",
    "text": "Bắt làm sao thế?"
  },
  {
    "start": "00:03:33.000",
    "end": "00:03:34.000",
    "text": "Cho bắt gấu."
  },
  {
    "start": "00:03:34.000",
    "end": "00:03:36.000",
    "text": "He he."
  },
  {
    "start": "00:03:36.000",
    "end": "00:03:37.000",
    "text": "Bắt là trung cháo đi."
  },
  {
    "start": "00:03:37.000",
    "end": "00:03:39.000",
    "text": "Rồi bắt sẽ buồn đồng không?"
  },
  {
    "start": "00:03:39.000",
    "end": "00:03:40.000",
    "text": "Bắt đừng gấu."
  },
  {
    "start": "00:03:41.000",
    "end": "00:03:43.000",
    "text": "Cháo cũng rất chứ mẹ."
  },
  {
    "start": "00:03:43.000",
    "end": "00:03:45.000",
    "text": "Nhưng cháo không bao giờ không?"
  },
  {
    "start": "00:03:45.000",
    "end": "00:03:48.000",
    "text": "Nếu biết cháo khóc, mẹ cháo sẽ rất buồn."
  },
  {
    "start": "00:03:48.000",
    "end": "00:03:51.000",
    "text": "Bắt bắt khóc là gấu con buồn đây."
  },
  {
    "start": "00:03:51.000",
    "end": "00:03:52.000",
    "text": "Bên à."
  },
  {
    "start": "00:03:52.000",
    "end": "00:03:54.000",
    "text": "Còn nói với bắt gấu điều ước đi."
  },
  {
    "start": "00:03:54.000",
    "end": "00:03:56.000",
    "text": "Nhân còn đứng bằng tiếp theo."
  },
  {
    "start": "00:03:56.000",
    "end": "00:03:59.000",
    "text": "Cháo ước mẹ cháo về với cháo."
  },
  {
    "start": "00:03:59.000",
    "end": "00:04:02.000",
    "text": "Bắt đừng qua điều ước của cháo nhé."
  },
  {
    "start": "00:04:05.000",
    "end": "00:04:07.000",
    "text": "Bắt gấu đi đâu thấy nhỉ?"
  },
  {
    "start": "00:04:09.000",
    "end": "00:04:10.000",
    "text": "Bắt gấu."
  },
  {
    "start": "00:04:10.000",
    "end": "00:04:12.000",
    "text": "Bắt sao thế hả?"
  },
  {
    "start": "00:04:12.000",
    "end": "00:04:14.000",
    "text": "Ừ. Bắt không sao?"
  },
  {
    "start": "00:04:14.000",
    "end": "00:04:16.000",
    "text": "Cháo ra chờ với các bạn đi."
  },
  {
    "start": "00:04:16.000",
    "end": "00:04:18.000",
    "text": "Kểu sắp đánh giờ về rồi."
  },
  {
    "start": "00:04:18.000",
    "end": "00:04:20.000",
    "text": "Bắt có thể hoa phép."
  },
  {
    "start": "00:04:20.000",
    "end": "00:04:23.000",
    "text": "Gởi bức thương này cho mẹ cháo được không hả?"
  },
  {
    "start": "00:04:23.000",
    "end": "00:04:26.000",
    "text": "Các cầu giáo bảo, buồn điện xa lắm."
  },
  {
    "start": "00:04:26.000",
    "end": "00:04:28.000",
    "text": "Oto sẽ không đi qua đó."
  },
  {
    "start": "00:04:28.000",
    "end": "00:04:31.000",
    "text": "Được. Bắt nhất định sẽ chuyện giúp cháo."
  },
  {
    "start": "00:04:32.000",
    "end": "00:04:34.000",
    "text": "Cháo cơm ăn bắt gấu hả?"
  },
  {
    "start": "00:04:36.000",
    "end": "00:04:37.000",
    "text": "Mẹ ơi."
  },
  {
    "start": "00:04:37.000",
    "end": "00:04:41.000",
    "text": "Bà bảo, mẹ đi làm chiếm tình để mua hòa cho con."
  },
  {
    "start": "00:04:41.000",
    "end": "00:04:43.000",
    "text": "Con không cần qua đeo ăn."
  },
  {
    "start": "00:04:43.000",
    "end": "00:04:45.000",
    "text": "Con không cần bức bề."
  },
  {
    "start": "00:04:45.000",
    "end": "00:04:47.000",
    "text": "Công cần gặp sát công dúa."
  },
  {
    "start": "00:04:47.000",
    "end": "00:04:50.000",
    "text": "Con chỉ cần mẹ về với con thôi."
  },
  {
    "start": "00:04:52.000",
    "end": "00:04:55.000",
    "text": "Còn gái, con về trước với các bạn nhé."
  },
  {
    "start": "00:04:55.000",
    "end": "00:04:58.000",
    "text": "Sớm bài mẹ sẽ về với con."
  },
  {
    "start": "00:04:58.000",
    "end": "00:05:00.000",
    "text": "Mẹ sẽ không đi thâu nữa."
  }
]